# ==============================================================================
# ShortVideo Environment Configuration
# Canonical references: TRD Section 4 & Backend Schema
# ==============================================================================

# Client-Side Variables (Vite - Public / Browser)
# The publishable/anon key is intentionally public; Row Level Security (RLS) protects all data.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"

# Server-Only Variables (Cloudflare Workers / Pages Functions / Server Functions)
# CRITICAL: Never prefix server variables with VITE_. Never expose service-role keys in frontend code.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-server-only-service-role-key"

# External Integrations (V1 Boundaries - Marked as Setup Required until configured)
LIVE_PROVIDER_API_KEY=""
LIVE_PROVIDER_WEBHOOK_SECRET=""
AD_PROVIDER_SERVER_KEY=""
